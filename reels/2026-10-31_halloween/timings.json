[
 {
  "t0": 0.0,
  "t1": 2.73,
  "text": "Говорят, Хеллоуин — страшный праздник."
 },
 {
  "t0": 2.73,
  "t1": 6.43,
  "text": "Скелеты, тыквы, вампиры… Ерунда."
 },
 {
  "t0": 6.43,
  "t1": 9.18,
  "text": "В прошлом году мне страшно стало только утром,"
 },
 {
  "t0": 9.18,
  "t1": 10.65,
  "text": "когда я открыл телефон."
 },
 {
  "t0": 10.65,
  "t1": 14.6,
  "text": "В два часа ночи я написал начальнику, что он хороший человек."
 },
 {
  "t0": 14.6,
  "t1": 15.66,
  "text": "Три раза."
 },
 {
  "t0": 15.66,
  "t1": 18.86,
  "text": "Бывшей жене отправил голосовое. Семь минут."
 },
 {
  "t0": 18.86,
  "t1": 19.87,
  "text": "С песней."
 },
 {
  "t0": 19.87,
  "t1": 24.4,
  "text": "А в чат нашего дома написал: «Соседи, я вас всех люблю!»"
 },
 {
  "t0": 24.4,
  "t1": 27.35,
  "text": "Соседи попросили любить их молча."
 },
 {
  "t0": 27.35,
  "t1": 30.36,
  "text": "Так что в этом году наряжусь привидением."
 },
 {
  "t0": 30.36,
  "t1": 31.87,
  "text": "Чтобы никто не узнал."
 },
 {
  "t0": 31.87,
  "t1": 33.75,
  "text": "Только тапочки надо сменить."
 },
 {
  "t0": 33.75,
  "t1": 35.3,
  "text": "Эти весь подъезд знает."
 }
]